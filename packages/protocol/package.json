{
  "name": "@threema/protocol",
  "description": "Threema protocol bindings, generated from the threema-protocols repository",
  "author": "Threema GmbH",
  "license": "AGPL-3.0+",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "pins": {
    "protoc": "35.1",
    "structbuf-typescript": "f61f79e3",
    "threema-protocols": "d5333b98"
  },
  "exports": {
    "./types": "./src/types.ts",
    "./types.js": "./src/types.ts",
    "./protobuf": "./src/protobuf/index.js",
    "./protobuf/tag": "./src/protobuf/tag.ts",
    "./structbuf/csp": "./src/structbuf/csp/index.ts",
    "./structbuf/extra": "./src/structbuf/extra/index.ts",
    "./structbuf/group-call": "./src/structbuf/group-call/index.ts",
    "./structbuf/md-d2d-rendezvous": "./src/structbuf/md-d2d-rendezvous/index.ts",
    "./structbuf/md-d2m": "./src/structbuf/md-d2m/index.ts",
    "./structbuf/*": "./src/structbuf/*.ts",
    "./structbuf/*.js": "./src/structbuf/*.ts"
  },
  "scripts": {
    "generate:protobuf": "node scripts/generate-protobuf.mjs",
    "generate:structbuf": "node scripts/generate-structbuf.mjs",
    "lint:tsc": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "update": "node scripts/update.mjs"
  },
  "dependencies": {
    "@threema/ts-utils": "workspace:*",
    "long": "catalog:",
    "protobufjs": "catalog:"
  },
  "devDependencies": {
    "@threema/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "protobufjs-cli": "1.1.3",
    "typescript": "catalog:"
  }
}
